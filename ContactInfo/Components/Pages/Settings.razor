@page "/settings"
@using ContactInfo.Services.Interfaces
@using System.Text.RegularExpressions
@inject IUserSettingsService UserSettings
@inject IHttpClientFactory HttpClientFactory
@rendermode InteractiveServer

<PageTitle>Settings</PageTitle>

<div class="container-fluid px-4 py-3" style="max-width:600px">
    <h4 class="mb-4">Settings</h4>

    <h6 class="text-muted mb-3">API Keys</h6>

    <div class="border rounded p-3 mb-3">
        <div class="d-flex align-items-center justify-content-between mb-1">
            <label class="form-label mb-0">Apollo.io API Key</label>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="apolloEnabled" @bind="ApolloEnabled" />
                <label class="form-check-label small text-muted" for="apolloEnabled">Enabled</label>
            </div>
        </div>
        <input class="form-control font-monospace"
               type="password"
               placeholder="Enter your Apollo API key"
               @bind="ApolloKey"
               disabled="@(!ApolloEnabled)" />
        <div class="form-text">
            Found at <a href="https://app.apollo.io/#/settings/integrations/api" target="_blank">
                Settings → Integrations → API
            </a> in your Apollo account.
            Free plan includes 100 email credits/month (10,000 with a business email).
        </div>
    </div>

    <div class="border rounded p-3 mb-3">
        <div class="d-flex align-items-center justify-content-between mb-1">
            <label class="form-label mb-0">RocketReach API Key</label>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="rocketReachEnabled" @bind="RocketReachEnabled" />
                <label class="form-check-label small text-muted" for="rocketReachEnabled">Enabled</label>
            </div>
        </div>
        <input class="form-control font-monospace"
               type="password"
               placeholder="Enter your RocketReach API key"
               @bind="RocketReachKey"
               disabled="@(!RocketReachEnabled)" />
        <div class="form-text">
            Found at <a href="https://rocketreach.co/api" target="_blank">
                rocketreach.co/api
            </a> under your account settings.
        </div>
    </div>

    <div class="border rounded p-3 mb-3">
        <div class="d-flex align-items-center justify-content-between mb-1">
            <label class="form-label mb-0">SignalHire API Key</label>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="signalHireEnabled" @bind="SignalHireEnabled" />
                <label class="form-check-label small text-muted" for="signalHireEnabled">Enabled</label>
            </div>
        </div>
        <input class="form-control font-monospace"
               type="password"
               placeholder="Enter your SignalHire API key"
               @bind="SignalHireKey"
               disabled="@(!SignalHireEnabled)" />
        <div class="form-text">
            Found at <a href="https://www.signalhire.com/profile#api" target="_blank">
                signalhire.com/profile#api
            </a> under your account settings.
            SignalHire delivers results via the Webhook Relay configured below.
        </div>
    </div>

    <h6 class="text-muted mb-3 mt-2">Webhook Relay</h6>

    <div class="border rounded p-3 mb-3">
        @if (_webhookExpired == true)
        {
            <div class="alert alert-warning py-2 small mb-3">
                <strong>Webhook relay URL has expired or is unreachable.</strong>
                Get a new URL from <a href="https://webhook.site" target="_blank">webhook.site</a>
                and paste it into the Callback URL field below.
            </div>
        }

        <p class="small text-muted mb-3">
            Some providers (e.g. SignalHire) deliver results by POSTing to a callback URL rather than
            returning them directly. Configure a webhook relay here so the app can receive those results.
            <a href="https://webhook.site" target="_blank">webhook.site</a> provides a free URL —
            paste it below and the relay poll URL will be filled in automatically.
        </p>

        <label class="form-label mb-1">
            Callback URL <span class="text-danger">*</span>
        </label>
        <input class="form-control font-monospace @(SignalHireEnabled && string.IsNullOrWhiteSpace(WebhookCallbackUrl) ? "is-invalid" : "")"
               type="url"
               placeholder="https://webhook.site/your-uuid"
               @bind="WebhookCallbackUrl" @bind:after="OnCallbackUrlChanged" />
        @if (SignalHireEnabled && string.IsNullOrWhiteSpace(WebhookCallbackUrl))
        {
            <div class="invalid-feedback">Required when SignalHire is enabled.</div>
        }
        <div class="form-text">
            The URL that API providers POST their results to.
        </div>

        <label class="form-label mt-3 mb-1">Relay Poll URL
            @if (WebhookCallbackUrl.Contains("webhook.site"))
            {
                <span class="text-success small ms-2">(auto-derived from webhook.site URL)</span>
            }
            else if (!string.IsNullOrWhiteSpace(WebhookCallbackUrl))
            {
                <span class="text-warning small ms-2">(required for non-webhook.site relays)</span>
            }
            else
            {
                <span class="text-muted fw-normal small ms-2">(leave blank if using webhook.site)</span>
            }
        </label>
        <input class="form-control font-monospace"
               type="url"
               placeholder="https://webhook.site/token/your-uuid/requests"
               @bind="WebhookRelayPollUrl"
               disabled="@(WebhookCallbackUrl.Contains("webhook.site"))" />
        <div class="form-text">
            The URL this app polls to retrieve results. Auto-derived for webhook.site;
            for other relay services enter their API endpoint here.
        </div>
    </div>

    <h6 class="text-muted mb-3 mt-2">General</h6>

    <div class="mb-4">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="demoMode" @bind="DemoModeEnabled" />
            <label class="form-check-label" for="demoMode">Demo mode</label>
        </div>
        <div class="form-text">
            Uses fake generated contacts instead of calling real APIs. Useful for testing the UI without consuming API credits.
        </div>
    </div>

    <button class="btn btn-primary" @onclick="Save">Save</button>

    @if (Saved)
    {
        <span class="ms-3 text-success small">Saved.</span>
    }
</div>

@code {
    private string ApolloKey             = "";
    private string RocketReachKey        = "";
    private string SignalHireKey         = "";
    private string WebhookCallbackUrl    = "";
    private string WebhookRelayPollUrl   = "";
    private bool   DemoModeEnabled       = true;
    private bool   ApolloEnabled         = true;
    private bool   RocketReachEnabled    = true;
    private bool   SignalHireEnabled     = true;
    private bool   Saved                 = false;
    private bool?  _webhookExpired       = null; // null=unchecked, false=ok, true=expired

    protected override async Task OnInitializedAsync()
    {
        ApolloKey           = UserSettings.ApolloApiKey;
        RocketReachKey      = UserSettings.RocketReachApiKey;
        SignalHireKey       = UserSettings.SignalHireApiKey;
        WebhookCallbackUrl  = UserSettings.WebhookCallbackUrl;
        WebhookRelayPollUrl = UserSettings.WebhookRelayPollUrl;
        DemoModeEnabled     = UserSettings.DemoMode;
        ApolloEnabled       = UserSettings.ApolloEnabled;
        RocketReachEnabled  = UserSettings.RocketReachEnabled;
        SignalHireEnabled   = UserSettings.SignalHireEnabled;

        await CheckWebhookRelayAsync();
    }

    private async Task CheckWebhookRelayAsync()
    {
        var pollUrl = ResolveRelayPollUrl();
        if (pollUrl is null) return;

        try
        {
            var http     = HttpClientFactory.CreateClient();
            var response = await http.GetAsync(pollUrl);
            _webhookExpired = !response.IsSuccessStatusCode;
        }
        catch
        {
            _webhookExpired = true;
        }
    }

    private string? ResolveRelayPollUrl()
    {
        var m = Regex.Match(WebhookCallbackUrl, @"webhook\.site/([0-9a-f\-]{36})", RegexOptions.IgnoreCase);
        if (m.Success)
            return $"https://webhook.site/token/{m.Groups[1].Value}/requests";
        return string.IsNullOrWhiteSpace(WebhookRelayPollUrl) ? null : WebhookRelayPollUrl;
    }

    private void OnCallbackUrlChanged()
    {
        var m = System.Text.RegularExpressions.Regex.Match(
            WebhookCallbackUrl,
            @"webhook\.site/([0-9a-f\-]{36})",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (m.Success)
            WebhookRelayPollUrl = $"https://webhook.site/token/{m.Groups[1].Value}/requests";
    }

    private void Save()
    {
        UserSettings.Save(ApolloKey, RocketReachKey, SignalHireKey,
                          WebhookCallbackUrl, WebhookRelayPollUrl,
                          DemoModeEnabled, ApolloEnabled, RocketReachEnabled, SignalHireEnabled);
        Saved = true;
    }
}
