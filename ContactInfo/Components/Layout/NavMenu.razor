<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <a class="navbar-brand" href="">ContactInfo</a>
        <span class="navbar-version">(v@(AppVersion))</span>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-person-lines-fill-nav-menu" aria-hidden="true"></span> Lookup
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Settings
            </NavLink>
        </div>
    </nav>
</div>

<div class="sidebar-footer">
    <img src="images/RS_logo.svg" alt="Client logo" />
</div>

@code {
    private static readonly string AppVersion =
        typeof(NavMenu).Assembly.GetName().Version?.ToString(3) ?? "";
}
